#!/bin/sh /etc/rc.common
# HR650X fan control web UI + controller (OpenWrt procd)
START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/python3
APP=/opt/hr650x/server.py
CONF=/opt/hr650x/HR650X.local.yaml
PORT=8765
BIND=0.0.0.0

start_service() {
    procd_open_instance hr650x
    procd_set_param command $PROG $APP -c $CONF --host $BIND --port $PORT --no-browser
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/hr650x.pid
    procd_close_instance
}
